# 이 청첩장 한 건의 모든 정보를 담습니다.
# 이름, 예식 정보, 예식장, 오시는 길, 사진, 계좌, API key가 전부 여기 모입니다.
# src/ 아래 HTML과 JS에는 실제 값이 하나도 없고 {{GROOM_NAME}} 같은 token만 있습니다.
# build.sh 가 이 파일을 읽어 그 token을 치환합니다.
#
# 쓰는 방법
#   1) 이 파일을 invitation.conf 로 복사합니다.
#        cp invitation.conf.example invitation.conf
#   2) 아래 값을 실제 정보로 바꿉니다.
#   3) ./build.sh 를 돌립니다. dist/ 에 완성된 청첩장이 나옵니다.
#
#   invitation.conf 는 .gitignore 대상이라 commit되지 않습니다. 그래서 fork해도
#   남의 개인정보가 따라오지 않습니다. 본인의 정보가 실수로 올라가지도 않습니다.
#
# 적는 규칙
#   - 값은 늘 따옴표로 감싸는 편이 안전합니다.
#       VENUE_NAME="별빛웨딩홀"
#   - 값 안의 \n 은 줄바꿈으로 해석됩니다. 오시는 길 안내에 씁니다.
#   - 목록은 콤마로 구분합니다.
#   - # 으로 시작하는 줄은 주석입니다.
#
# 이 파일의 값은 전부 가상의 demo 데이터입니다. 그대로 build하면 demo 청첩장이 나옵니다.
# 두 구성(static, with-guestbook)이 같은 형식을 읽으므로 이 파일을 그대로 옮겨 쓸 수 있습니다.


# --- 이 청첩장을 올릴 주소 ---
# 카카오톡 공유 미리보기(og:image)는 절대 URL이어야 읽힙니다. 그래서 배포할 domain이 필요합니다.
# 아직 정하지 않았으면 비워 둡니다. 화면은 정상이고 공유 card의 사진만 빠집니다.
SITE_ORIGIN="https://invitation.example.com"

# 축하 한마디를 받을 API 주소입니다.
#   비우면 축하 한마디를 저장할 곳이 없으므로 입력창과 기록 목록이 나오지 않습니다.
#   AI agent들의 축하는 저장이 필요 없으므로 그대로 나옵니다.
#   하객이 남긴 축하를 실제로 모으려면 ../with-guestbook 을 띄운 뒤 그 주소를 여기 적습니다.
#     GUESTBOOK_API_BASE="https://guestbook.example.com/api"
GUESTBOOK_API_BASE=""

# 처음 열었을 때 보여줄 version입니다. main, developer, terminal 중 하나입니다.
# dist/index.html 이 이 version의 사본이 됩니다. 세 version은 언제나 함께 build되고
# 화면 아래 전환 link로 서로 이동할 수 있습니다.
DEFAULT_VERSION="main"


# --- 신랑 ---
GROOM_NAME="김앙아"
GROOM_NAME_SHORT="앙아"
GROOM_NAME_EN="Anga Kim"
# 사진이 없을 때 대신 보여줄 한 글자입니다.
GROOM_INITIAL="앙"
GROOM_ROLE="DevSecOps Engineer"
# 부모 이름입니다. 표시 순서 그대로 콤마로 구분합니다.
GROOM_PARENTS="김철수,이영희"
GROOM_RANK_KO="차남"
# 위 서열을 code 표현으로 옮긴 장식 문구입니다. developer version에 나옵니다.
GROOM_RANK_EXPR="sons[1]"
GROOM_MBTI="ENFJ"
GROOM_HOBBY="등산, 서예"
# developer version의 주석 한 줄입니다.
GROOM_NOTE="// always on-call for her"
# 프로필 사진입니다. src/photos/ 아래 파일 이름을 적습니다. 비우면 이니셜 box로 fallback합니다.
GROOM_PHOTO="demo-groom.jpg"
# 세로 4:5 frame의 crop 초점(CSS object-position)과 확대 배율입니다.
GROOM_PHOTO_FOCUS="50% 30%"
GROOM_PHOTO_ZOOM="1"


# --- 신부 ---
BRIDE_NAME="최엥에"
BRIDE_NAME_SHORT="엥에"
BRIDE_NAME_EN="Enge Choi"
BRIDE_INITIAL="엥"
BRIDE_ROLE="Backend Developer"
BRIDE_PARENTS="최민수,박지영"
BRIDE_RANK_KO="장녀"
BRIDE_RANK_EXPR="children[0]"
BRIDE_MBTI="ENFJ"
BRIDE_HOBBY="거문고, 그네뛰기"
BRIDE_NOTE="// her promises always resolve"
BRIDE_PHOTO="demo-bride.jpg"
BRIDE_PHOTO_FOCUS="50% 30%"
BRIDE_PHOTO_ZOOM="1"


# --- 예식 일시 ---
# offset을 포함한 ISO 8601로 적습니다. countdown과 달력, D-day가 이 값에서 자동 계산됩니다.
WEDDING_AT="2026-11-14T11:00:00+09:00"
# 두 사람이 처음 만난 날입니다. terminal version의 uptime과 진행 bar 기준점입니다.
FIRST_MET_AT="2024-10-03T00:00:00+09:00"


# --- 예식장 ---
VENUE_NAME="별빛웨딩홀"
VENUE_HALL="그랜드홀"
VENUE_ADDRESS="서울특별시 중구 세종대로 110"
VENUE_FLOOR="3층"
# 주소 복사 button이 clipboard에 넣는 문자열입니다.
VENUE_ADDRESS_COPY="서울특별시 중구 세종대로 110 별빛웨딩홀 3층"
# 가장 가까운 역입니다. 짧은 쪽은 좁은 화면용입니다.
VENUE_SUBWAY="1호선과 2호선 시청역"
VENUE_SUBWAY_SHORT="1호선 / 2호선 시청역"

# 지도에 찍을 좌표와 확대 수준입니다.
VENUE_LAT="37.5662952"
VENUE_LNG="126.9779451"
VENUE_MAP_ZOOM="17"

# 길찾기 button이 여는 외부 지도 link입니다.
MAP_NAVER_URL="https://map.naver.com/"
MAP_KAKAO_URL="https://map.kakao.com/"


# --- 오시는 길 안내 ---
# \n 으로 줄을 나눕니다.
INFO_SUBWAY="1호선 / 2호선 시청역\n5번 출구에서 도보 3분"
INFO_BUS="시청역 또는 덕수궁 하차"
INFO_PARKING="건물 지하 주차장 이용\n자가용 이용 시 무료주차 2시간\n(주차권 수령 필요)"
INFO_MEAL="예식 30분 전부터 식사하실 수 있습니다.\n같은 층 연회장에서 뷔페로 준비했습니다."


# --- 사진 ---
# src/photos/ 아래 파일 이름을 적습니다.
# 기본값은 함께 들어 있는 demo-*.jpg 입니다. 두 분의 사진으로 바꿔 주시기 바랍니다.
# 비워 두어도 자리 표시가 나와 화면이 깨지지 않습니다.
#
#   PHOTO_MAIN      main version 표지
#   PHOTO_MAIN_DEV  developer version 표지. terminal version에는 표지가 없습니다.
#   PHOTO_BLESS     축하 전하기 아래 전체폭 사진
#   PHOTO_GALLERY   gallery 목록. 3x3 pagination이라 9장이 한 page입니다.
PHOTO_MAIN="demo-cover.jpg"
PHOTO_MAIN_DEV="demo-cover-dev.jpg"
PHOTO_BLESS="demo-bless.jpg"
PHOTO_GALLERY="demo-g01.jpg,demo-g02.jpg,demo-g03.jpg,demo-g04.jpg,demo-g05.jpg,demo-g06.jpg,demo-g07.jpg,demo-g08.jpg,demo-g09.jpg"

# version별 gallery page 표시 순서입니다. 1부터 시작하는 page 번호를 콤마로 적습니다.
# 비우면 PHOTO_GALLERY에 적은 순서 그대로입니다.
GALLERY_ORDER_MAIN=""
GALLERY_ORDER_DEV=""

# 공유 card 이미지(og:image)입니다. 비우면 각 version의 표지를 그대로 씁니다.
PHOTO_OG_MAIN=""
PHOTO_OG_DEV=""
PHOTO_OG_TERMINAL=""


# --- 계좌 ---
# 형식은 이름|은행|계좌번호 이고 사람은 콤마로 구분합니다.
# 사람을 늘리거나 줄이려면 콤마로 구분된 항목만 더하거나 빼면 됩니다.
# 이름과 은행, 번호 안에는 | 와 , 를 쓰지 않습니다.
#
# 이 값은 난독화해서 HTML에 넣습니다. 그래서 결과물의 어느 파일에도 평문 계좌번호가
# 남지 않습니다. 하객이 '마음 전하실 곳'을 펼칠 때에만 화면에 그려집니다.
# 주의: 난독화는 암호화가 아닙니다. browser가 풀어야 하므로 마음먹은 사람은 읽을 수 있습니다.
#   목적은 검색 engine 노출과 자동수집 차단입니다.
GROOM_ACCOUNTS="김앙아|달빛은행|000-0000-0000,김철수|달빛은행|000-0000-0000,이영희|달빛은행|000-0000-0000"
BRIDE_ACCOUNTS="최엥에|달빛은행|000-0000-0000,최민수|달빛은행|000-0000-0000,박지영|달빛은행|000-0000-0000"


# --- 외부 서비스 key ---
# 둘 다 domain 제한 공개key라 browser에 노출돼도 되는 값입니다. 비워도 화면은 정상 동작합니다.
# 발급과 domain 등록 절차는 README.md 에 적어 두었습니다.

# 네이버 지도 key입니다. NCP 콘솔의 Maps 애플리케이션에 있는 ncpKeyId(Web Dynamic Map)입니다.
#   - ncpKeyId 하나만 넣습니다. Client Secret 은 server 전용이라 절대 넣지 않습니다.
#   - 비우면 지도 대신 안내 문구가 나오고 길찾기 button은 그대로 동작합니다.
#   - 주의: NCP Maps 애플리케이션의 'Web 서비스 URL'에 배포 domain을 등록해야 지도가 나옵니다.
NAVER_MAP_KEY_ID=""

# 카카오 공유 key입니다. Kakao Developers 앱의 JavaScript key입니다.
#   - 이 key가 있어야 카카오톡에서 공유하기가 친구 선택창까지 열리고 미리보기 card가 나옵니다.
#     비우면 navigator.share 나 link 복사로 fallback합니다.
#   - JavaScript key만 넣습니다. REST API key와 Admin key는 server 전용 비밀입니다.
#   - 주의: domain을 두 군데에 등록해야 합니다. 한 곳만 하면 공유 호출이 거절됩니다.
#     [플랫폼 키 > JavaScript 키 > JavaScript SDK 도메인] 은 Kakao.init 을 실행하는 쪽입니다.
#     [제품 링크 관리 > 웹 도메인] 은 공유 card를 눌렀을 때 이동할 쪽입니다.
KAKAO_JS_KEY=""

# Google Analytics 측정 ID입니다. GA4 속성의 데이터 스트림에 있는 G- 로 시작하는 값입니다.
#   - 비우면 gtag script를 아예 불러오지 않습니다. 요청도 나가지 않습니다.
#   - 두 구성이 각자 conf를 가지므로 static과 with-guestbook에 다른 ID를 넣어도 됩니다.
#   - 이 파일은 .gitignore 대상이라 fork한 쪽에는 빈 값이 갑니다.
#     남의 방문 기록이 내 속성으로 들어오지 않게 하려는 것입니다.
#   - 하객의 방문을 기록하므로, 남기실 안내가 있으면 청첩장에 함께 적어 주시기 바랍니다.
GA_MEASUREMENT_ID=""
